---
import { site } from '../../config/site';
import { localeMeta, localePath, locales, toLocale, useDictionary } from '../../i18n';
import Button from '../ui/Button.astro';

const locale = toLocale(Astro.currentLocale);
const t = useDictionary(locale);

/** On pages other than the landing, pass home="/" so in-page anchors point back to the landing. */
interface Props {
  home?: string;
}
const { home = '' } = Astro.props;
const href = (link: string) => (link.startsWith('#') ? `${home}${link}` : link);
---

<header class="nav">
  <div class="container bar">
    <a class="brand" href={home || '#top'} aria-label={`${site.name}, ${t.a11y.home}`}>
      <img src={site.logo.src} width={site.logo.width} height={site.logo.height} alt="" />
      <span class="brand-name">
        {site.name}
        <span class="slogan">{site.slogan.join(' · ')}</span>
      </span>
    </a>
    <nav aria-label={t.a11y.sections}>
      <ul>
        {t.nav.links.map((link) => <li><a href={href(link.href)}>{link.label}</a></li>)}
      </ul>
    </nav>
    <div class="lang" role="group" aria-label={t.a11y.languageSwitch}>
      {
        locales.map((code) =>
          code === locale ? (
            <span class="lang-current" aria-current="true" title={localeMeta[code].label}>
              {localeMeta[code].short}
            </span>
          ) : (
            <a href={localePath(code)} hreflang={localeMeta[code].htmlLang} lang={localeMeta[code].htmlLang} title={localeMeta[code].label}>
              {localeMeta[code].short}
            </a>
          ),
        )
      }
    </div>
    <Button href={`${home}#solicitud`} class="nav-cta">{t.nav.cta}</Button>
  </div>
</header>

<style>
  /* Frosted glass: the page shows through blurred, with enough navy tint to keep links
     at 4.5:1 over the light paper sections. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: linear-gradient(180deg, rgb(20 32 74 / 0.74), rgb(11 19 48 / 0.66));
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgb(255 255 255 / 0.12);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      0 10px 30px -14px rgb(11 19 48 / 0.5);
    color: var(--on-navy);
  }
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .nav {
      background: rgb(11 19 48 / 0.94);
    }
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    min-height: 4.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    text-decoration: none;
    margin-right: auto;
  }
  .brand img {
    width: 3rem;
    height: auto;
    border-radius: 8px;
    background: #fff;
    padding: 2px;
  }
  .brand-name {
    display: grid;
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 112%;
    font-size: 1.0625rem;
    line-height: 1.15;
  }
  .slogan {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.625rem;
    font-stretch: 100%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sun);
  }
  ul {
    display: flex;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-control);
    color: var(--on-navy);
    font-weight: 500;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  nav a:hover {
    background: rgb(255 255 255 / 0.12);
  }

  /* Language switch reads like a two-cell document field */
  .lang {
    display: flex;
    border: 1.5px solid rgb(185 196 226 / 0.35);
    border-radius: var(--radius-control);
    overflow: hidden;
    font-family: var(--font-data);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }
  .lang > * {
    display: grid;
    place-items: center;
    min-width: 2.5rem;
    min-height: 2.25rem;
    padding: 0 var(--space-2);
  }
  .lang-current {
    background: var(--on-navy);
    color: var(--navy-900);
    font-weight: 600;
  }
  .lang a {
    color: var(--on-navy);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out), background-color var(--dur-fast) var(--ease-out);
  }
  .lang a:hover {
    color: var(--on-navy);
    background: rgb(255 255 255 / 0.1);
  }

  .bar :global(.nav-cta) {
    min-height: 2.75rem;
    padding-block: 0.55em;
  }

  @media (max-width: 1060px) {
    nav {
      display: none;
    }
  }
  @media (max-width: 480px) {
    .slogan {
      display: none;
    }
    .bar {
      gap: var(--space-3);
    }
    .brand-name {
      display: none;
    }
    .bar :global(.nav-cta) {
      padding-inline: 1em;
    }
  }
</style>
