---
import { modalities } from '../../data/modalities';
import { useDictionary } from '../../i18n';
import PhotoWindow from '../ui/PhotoWindow.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Stamp from '../ui/Stamp.astro';
import Value from '../ui/Value.astro';

const t = useDictionary(Astro.currentLocale);
const copy = t.modalities;
---

<section class="modalities paper" aria-labelledby="modalidades">
  <div class="container">
    <SectionHeading id="modalidades" title={copy.title} lead={copy.lead} />

    <div class="entries">
      {
        modalities.map((modality, index) => {
          const item = copy.items[modality.id];
          return (
            <article class="entry">
              <PhotoWindow image={{ src: modality.photo, alt: item.imageAlt, brief: item.imageBrief }} ratio="16 / 10" />
              <div class="entry-text">
                <h3>{item.name}</h3>
                <p>{item.pitch}</p>
                <dl>
                  {item.details.map((detail) => (
                    <div>
                      <dt class="data-label">{detail.label}</dt>
                      <dd>
                        <Value value={detail.value} fallback={copy.detailFallback} />
                      </dd>
                    </div>
                  ))}
                </dl>
              </div>
              <Stamp
                class="entry-stamp"
                shape="rect"
                top={copy.entry}
                main={item.name}
                bottom="Ecu593 English"
                ink={modality.stampInk}
                rotate={index === 0 ? -7 : 6}
                size="clamp(10rem, 16vw, 13rem)"
              />
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .modalities {
    padding-block: var(--space-9);
    /* Its stamp waits at 1.7× scale before it thumps in (scripts/motion.ts) and would widen the page. */
    overflow-x: clip;
  }
  .entries {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 1rem + 2.5vw, 3.5rem);
    margin-top: var(--space-8);
    align-items: start;
  }
  .entry:nth-child(2) {
    margin-top: var(--space-8);
  }
  .entry:only-child {
    grid-column: 1 / -1;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    gap: clamp(1.5rem, 1rem + 2.5vw, 3.5rem);
  }
  .entry {
    position: relative;
    display: grid;
    gap: var(--space-5);
  }
  .entry-text {
    display: grid;
    gap: var(--space-3);
    max-width: 34rem;
  }
  h3 {
    font-size: var(--step-2);
    color: var(--navy-900);
  }
  p {
    color: var(--ink-soft);
  }
  dl {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-2) 0 0;
    padding-top: var(--space-4);
    border-top: 1.5px solid var(--rule);
  }
  dd {
    margin: 2px 0 0;
    font-weight: 500;
  }
  .entry :global(.entry-stamp) {
    position: absolute;
    right: -0.5rem;
    top: -1.75rem;
  }

  @media (max-width: 760px) {
    .entries {
      grid-template-columns: 1fr;
    }
    .entry:nth-child(2) {
      margin-top: var(--space-4);
    }
    .entry:only-child {
      grid-template-columns: 1fr;
    }
  }
</style>
