---
import { site } from '../../config/site';
import { useDictionary } from '../../i18n';
import { buildWhatsAppUrl } from '../../lib/whatsapp';
import Button from '../ui/Button.astro';
import Mrz from '../ui/Mrz.astro';
import Stamp from '../ui/Stamp.astro';

const t = useDictionary(Astro.currentLocale);
const { hero } = t;
---

<section class="cover" id="top" aria-labelledby="hero-title" data-hero>
  <div class="container spread" data-spread>
    <div class="page page-pitch" data-pitch>
      <h1 id="hero-title">
        <span class="eyebrow" data-hero-line>{hero.eyebrow}</span>
        <span class="title" data-hero-title>{hero.title}</span>
      </h1>
      <p class="sub" data-hero-line>{hero.sub}</p>
      <div class="actions" data-hero-line>
        <Button href="#solicitud">{hero.ctaPrimary}</Button>
        <Button href={buildWhatsAppUrl(t.whatsapp.greeting)} variant="whatsapp" external>{hero.ctaWhatsapp}</Button>
      </div>
      <Stamp class="stamp-a" {...hero.stamps.slogan} ink="flame" rotate={-12} size="clamp(7rem, 12vw, 10rem)" />
    </div>

    <div class="page page-data" aria-label={hero.passportLabel} data-data-page>
      <div class="doc-head" data-doc-line>
        <span>{hero.docHead[0]}</span>
        <span class="alt">{hero.docHead[1]}</span>
      </div>
      <div class="doc-body">
        <div class="photo" data-doc-line>
          <img src={site.logo.src} width={site.logo.width} height={site.logo.height} alt={site.name} fetchpriority="high" />
        </div>
        <dl class="fields">
          <div class="row-3" data-doc-line>
            <div><dt class="data-label">{hero.idLabels.type}</dt><dd>P</dd></div>
            <div><dt class="data-label">{hero.idLabels.code}</dt><dd>ECU593</dd></div>
            <div><dt class="data-label">{hero.idLabels.number}</dt><dd class="tabular">L-01</dd></div>
          </div>
          {
            hero.fields.map((field) => (
              <div data-doc-line>
                <dt class="data-label">{field.label}</dt>
                <dd>{field.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div data-doc-line class="doc-mrz">
        <Mrz lines={hero.mrz} />
      </div>
      <Stamp class="stamp-b" shape="rect" {...hero.stamps.entry} ink="sky" rotate={7} size="clamp(9rem, 14vw, 11.5rem)" />
      <Stamp class="stamp-c" {...hero.stamps.modality} ink="violet" rotate={16} size="clamp(6rem, 9vw, 7.5rem)" />
    </div>

    <!-- Front cover: only shown while GSAP plays the opening (scripts/motion.ts). -->
    <div class="book-cover" aria-hidden="true" data-book-cover>
      <div class="face face-front">
        <span class="cover-country">{hero.cover.country}</span>
        <svg class="cover-emblem" viewBox="0 0 120 120" fill="none" stroke="currentColor">
          <circle cx="60" cy="60" r="56" stroke-width="2" />
          <circle cx="60" cy="60" r="50" stroke-width="0.75" stroke-dasharray="2 3" />
          <circle cx="60" cy="60" r="34" stroke-width="1.5" />
          {
            Array.from({ length: 24 }, (_, i) => (
              <ellipse cx="60" cy="60" rx="44" ry="12" stroke-width="0.5" transform={`rotate(${i * 7.5} 60 60)`} />
            ))
          }
          <text x="60" y="60" fill="currentColor" stroke="none" text-anchor="middle" dominant-baseline="central">593</text>
        </svg>
        <span class="cover-title">{hero.cover.title}</span>
        <span class="cover-subtitle">{hero.cover.subtitle}</span>
        <svg class="cover-chip" viewBox="0 0 40 28" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="1" y="1" width="38" height="26" rx="3" />
          <circle cx="20" cy="14" r="6" />
          <path d="M1 14h13M26 14h13" />
        </svg>
      </div>
      <div class="face face-inside"></div>
    </div>
  </div>
</section>

<style>
  .cover {
    position: relative;
    overflow: clip;
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(3rem, 2rem + 5vw, 6rem);
    background:
      var(--rosette-cover) right -18rem top -14rem / 56rem no-repeat,
      var(--rosette-cover) left -22rem bottom -26rem / 48rem no-repeat,
      radial-gradient(120% 90% at 50% 0%, var(--navy-800), var(--navy-900) 60%, var(--navy-950));
    color: var(--on-navy);
  }

  .spread {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    perspective: 2400px;
  }

  .page {
    position: relative;
    padding: clamp(1.5rem, 1rem + 2.4vw, 3.25rem);
    background-color: var(--paper);
    background-image: var(--guilloche-band);
    background-size: 240px 96px;
    color: var(--ink);
    box-shadow: 0 30px 70px -30px rgb(0 0 0 / 0.7);
  }

  /* Pitch is the right-hand page on desktop, first on mobile. */
  .page-pitch {
    order: 2;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-5);
    border-radius: 0 var(--radius-page) var(--radius-page) 0;
    box-shadow:
      inset 28px 0 32px -26px rgb(11 19 48 / 0.45),
      0 30px 70px -30px rgb(0 0 0 / 0.7);
  }
  .page-data {
    order: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    border-radius: var(--radius-page) 0 0 var(--radius-page);
    background-image: var(--rosette-paper), var(--guilloche-band);
    background-size: 34rem, 240px 96px;
    background-position: 60% 40%, 0 0;
    background-repeat: no-repeat, repeat;
    box-shadow:
      inset -28px 0 32px -26px rgb(11 19 48 / 0.45),
      0 30px 70px -30px rgb(0 0 0 / 0.7);
  }

  h1 {
    display: grid;
    gap: var(--space-3);
    color: var(--navy-900);
  }
  .eyebrow {
    font-family: var(--font-body);
    font-stretch: 100%;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sky-text);
  }
  .title {
    display: block;
    font-size: var(--step-4);
    max-width: 11ch;
  }
  .sub {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 34rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    position: relative;
    z-index: 2;
  }

  .doc-head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1.5px solid var(--rule);
    font-family: var(--font-display);
    font-stretch: 87%;
    font-weight: 750;
    font-size: 0.875rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--navy-800);
  }
  .doc-head .alt {
    color: var(--ink-soft);
    font-weight: 500;
  }
  .doc-body {
    display: grid;
    grid-template-columns: minmax(7rem, 0.8fr) 1.6fr;
    gap: clamp(1rem, 0.6rem + 1.4vw, 2rem);
    align-items: start;
  }
  .photo {
    padding: 6px;
    border-radius: 10px;
    background: var(--paper-deep);
    box-shadow: inset 0 0 0 1px var(--paper-edge);
  }
  .photo img {
    width: 100%;
    height: auto;
    border-radius: 6px;
  }
  .fields {
    display: grid;
    gap: var(--space-3);
    margin: 0;
  }
  .fields dd {
    margin: 2px 0 0;
    font-family: var(--font-display);
    font-stretch: 100%;
    font-weight: 700;
    font-size: clamp(0.95rem, 0.85rem + 0.35vw, 1.125rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .row-3 {
    display: grid;
    grid-template-columns: auto auto auto;
    justify-content: start;
    gap: var(--space-5);
  }
  .doc-mrz {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top: 1.5px solid var(--rule);
    min-width: 0;
  }

  .page :global(.stamp-a) {
    position: absolute;
    right: 4%;
    top: 5%;
  }
  .page :global(.stamp-b) {
    position: absolute;
    right: 5%;
    bottom: 5%;
  }
  .page :global(.stamp-c) {
    position: absolute;
    right: 5%;
    top: 36%;
  }

  /* Closed front cover, hinged at the spine. Hidden unless the opening animation runs. */
  .book-cover {
    display: none;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 50%;
    z-index: 6;
    transform-origin: left center;
    transform-style: preserve-3d;
  }
  :global(.gsap-on) .book-cover {
    display: block;
  }
  .face {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  .face-front {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    border-radius: 6px var(--radius-page) var(--radius-page) 6px;
    background:
      var(--rosette-cover) center / 150% no-repeat,
      radial-gradient(130% 100% at 30% 20%, #22306a, var(--navy-900) 55%, #0d1638);
    box-shadow:
      inset 10px 0 18px -10px rgb(0 0 0 / 0.6),
      inset 0 0 0 1px rgb(255 255 255 / 0.06),
      0 40px 80px -30px rgb(0 0 0 / 0.8);
    color: var(--sun);
    text-transform: uppercase;
    text-align: center;
  }
  .face-inside {
    transform: rotateY(180deg);
    border-radius: var(--radius-page) 6px 6px var(--radius-page);
    background-color: var(--paper);
    background-image: var(--guilloche-band);
    background-size: 240px 96px;
    box-shadow: inset -28px 0 32px -26px rgb(11 19 48 / 0.45);
  }
  .cover-country,
  .cover-subtitle {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.32em;
  }
  .cover-emblem {
    width: clamp(7rem, 12vw, 10rem);
  }
  .cover-emblem text {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 22px;
  }
  .cover-title {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(1.75rem, 1rem + 2.4vw, 3rem);
    letter-spacing: 0.12em;
  }
  .cover-chip {
    width: 2.5rem;
    margin-top: var(--space-4);
    opacity: 0.85;
  }

  @media (max-width: 900px) {
    .spread {
      grid-template-columns: 1fr;
    }
    .page-pitch {
      order: 1;
      border-radius: var(--radius-page) var(--radius-page) 0 0;
      box-shadow: inset 0 -28px 32px -28px rgb(11 19 48 / 0.4);
    }
    .page-data {
      order: 2;
      border-radius: 0 0 var(--radius-page) var(--radius-page);
      box-shadow:
        inset 0 28px 32px -28px rgb(11 19 48 / 0.4),
        0 30px 70px -30px rgb(0 0 0 / 0.7);
    }
    .book-cover {
      left: 0;
      width: 100%;
    }
    .face-front {
      justify-content: flex-start;
      padding-top: clamp(4rem, 18vw, 7rem);
      border-radius: var(--radius-page);
    }
    .page :global(.stamp-a) {
      top: 0.5rem;
      right: 0.5rem;
      --size: 5.5rem !important;
    }
    .page :global(.stamp-b) {
      bottom: 0.5rem;
      right: 0.75rem;
    }
  }
  @media (max-width: 520px) {
    .doc-body {
      grid-template-columns: 6.5rem 1fr;
    }
    .row-3 {
      grid-template-columns: auto auto;
    }
    .row-3 > :last-child {
      display: none;
    }
    .page :global(.stamp-c) {
      right: 0.75rem;
      top: 0.25rem;
    }
  }
</style>
