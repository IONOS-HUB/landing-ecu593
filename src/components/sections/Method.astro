---
import { levels, LEVEL_COUNT, TOTAL_WEEKS, WEEKS_PER_LEVEL } from '../../data/method';
import { COURSE_MONTHS } from '../../data/pricing';
import { useDictionary } from '../../i18n';
import { isPending } from '../../lib/pending';
import Stamp from '../ui/Stamp.astro';
import Value from '../ui/Value.astro';

const t = useDictionary(Astro.currentLocale);
const copy = t.method;
const inks = ['flame', 'sky', 'violet', 'navy'] as const;
const pad = (n: number) => String(n).padStart(2, '0');
---

<section class="method" aria-labelledby="metodo">
  <div class="container layout">
    <div class="aside">
      <div class="aside-inner">
        <h2 id="metodo">{copy.title}</h2>
        <p class="lead">{copy.lead}</p>

        <div class="counter" data-counter data-weeks-per-level={WEEKS_PER_LEVEL}>
          <span class="data-label">{copy.counterLabel}</span>
          <p class="count tabular">
            <span data-stamp-count>{pad(LEVEL_COUNT)}</span><span class="of">/{LEVEL_COUNT}</span>
          </p>
          <p class="weeks tabular">
            <span data-week-count>{TOTAL_WEEKS}</span>{' '}{copy.weeksOf}
          </p>
          <div class="track" aria-hidden="true"><span data-track></span></div>
        </div>

        <dl class="rules">
          {
            copy.evaluation.map((rule) => (
              <div>
                <dt class="data-label">{rule.label}</dt>
                <dd>{rule.value}</dd>
              </div>
            ))
          }
        </dl>
        {isPending(copy.levelContent) && <p class="content-note"><Value value={copy.levelContent} /></p>}
      </div>
    </div>

    <ol class="pages" data-level-pages>
      {
        levels.map((level, index) => (
          <li class="level" data-level>
            <span class="data-label">{copy.levelLabel}</span>
            <span class="number tabular">{pad(level.number)}</span>
            <span class="range tabular">{copy.weeksRange(level.weekFrom, level.weekTo)}</span>
            {!isPending(level.cefr) && <span class="cefr">{level.cefr}</span>}
            <Stamp
              class="level-stamp"
              shape={index % 3 === 1 ? 'rect' : 'circle'}
              top={copy.stamp.top(pad(level.number))}
              main={copy.stamp.main}
              bottom={copy.stamp.bottom(level.weekTo)}
              ink={inks[index % inks.length]}
              rotate={[-9, 6, -4, 11, -13, 3][index % 6]}
              size={index % 3 === 1 ? '9.5rem' : '7.75rem'}
            />
          </li>
        ))
      }
      <li class="bonus">
        <span class="bonus-number tabular" aria-hidden="true">{COURSE_MONTHS}</span>
        <div class="bonus-text">
          <span class="data-label">{copy.bonus.label}</span>
          <p class="bonus-title">{copy.bonus.title}</p>
          <p>{copy.bonus.body}</p>
          <a href="#mes-13">{copy.bonus.link}</a>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .method {
    padding-block: var(--space-9);
    background-color: var(--paper-deep);
    background-image: var(--guilloche-band);
    background-size: 240px 96px;
    border-block: 1.5px solid var(--paper-edge);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(18rem, 0.85fr) 1.4fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: start;
  }
  .aside {
    position: sticky;
    top: 6rem;
  }
  .aside-inner {
    display: grid;
    gap: var(--space-5);
  }
  h2 {
    font-size: var(--step-3);
    color: var(--navy-900);
  }
  .lead {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .counter {
    display: grid;
    gap: var(--space-1);
    padding: var(--space-5);
    border-radius: var(--radius-page);
    background: var(--navy-900);
    color: var(--on-navy);
    box-shadow: var(--shadow-lift);
  }
  .counter .data-label {
    color: var(--on-navy-soft);
  }
  .count {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(3.5rem, 2.5rem + 3vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--sun);
  }
  .of {
    color: var(--on-navy-soft);
    font-size: 0.45em;
    letter-spacing: 0;
    margin-left: 0.1em;
  }
  .weeks {
    font-family: var(--font-data);
    font-size: 0.8125rem;
    color: var(--on-navy-soft);
  }
  .track {
    height: 6px;
    margin-top: var(--space-3);
    border-radius: 99px;
    background: rgb(255 255 255 / 0.12);
    overflow: hidden;
  }
  .track span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--sun) 0 50%, var(--sky) 50% 75%, var(--flame) 75%);
    transform-origin: left;
    transform: scaleX(var(--progress, 1));
    transition: transform var(--dur-base) var(--ease-out);
  }

  .rules {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4) var(--space-5);
    margin: 0;
  }
  .rules dd {
    margin: 2px 0 0;
    font-weight: 600;
  }

  .pages {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }
  .level {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-height: 15rem;
    padding: var(--space-5);
    border-radius: 10px;
    background:
      var(--rosette-paper) 140% 140% / 18rem no-repeat,
      var(--paper);
    box-shadow: var(--shadow-page), inset 0 0 0 1px var(--paper-edge);
    overflow: hidden;
  }
  .number {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: 2.75rem;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--navy-900);
  }
  .range {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-soft);
  }
  .cefr {
    font-weight: 700;
    color: var(--sky-text);
  }
  .level :global(.level-stamp) {
    position: absolute;
    right: 0.5rem;
    bottom: 0.75rem;
  }
  /* The "+1": month 13 closes the path as a navy cover page spanning the whole row. */
  .bonus {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    padding: var(--space-5) clamp(1.25rem, 1rem + 2vw, 2.5rem);
    border-radius: 10px;
    background:
      var(--rosette-cover) right -8rem center / 26rem no-repeat,
      var(--navy-900);
    color: var(--on-navy);
    box-shadow: var(--shadow-lift);
    border-top: 4px solid transparent;
    border-image: linear-gradient(90deg, var(--sun) 0 50%, var(--sky) 50% 75%, var(--flame) 75%) 1;
  }
  .bonus-number {
    flex: none;
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(3.5rem, 2.5rem + 3vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--sun);
  }
  .bonus-text {
    display: grid;
    gap: var(--space-1);
  }
  .bonus .data-label {
    color: var(--on-navy-soft);
  }
  .bonus-title {
    font-family: var(--font-display);
    font-stretch: 112%;
    font-weight: 800;
    font-size: var(--step-1);
    line-height: 1.15;
    color: var(--sun);
  }
  .bonus p {
    margin: 0;
    color: var(--on-navy-soft);
  }
  .bonus a {
    justify-self: start;
    margin-top: var(--space-2);
    color: var(--on-navy);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }
  .bonus a:hover {
    color: var(--sun);
  }

  .content-note {
    font-size: var(--step--1);
  }

  @media (max-width: 1080px) {
    .pages {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 820px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .aside {
      position: static;
    }
  }
  @media (max-width: 520px) {
    .level {
      min-height: 12.5rem;
      padding: var(--space-4);
    }
    .level :global(.level-stamp) {
      --size: 6.25rem !important;
    }
    .rules {
      grid-template-columns: 1fr;
    }
  }
</style>
