---
/**
 * Month 13, the "+1" of the 12 + 1 program: institutional diploma + free Cambridge preparation.
 * This is the core value proposition, so it gets its own high-contrast block right after the level path.
 */
import { FINAL_CEFR } from '../../data/method';
import { COURSE_MONTHS } from '../../data/pricing';
import { useDictionary } from '../../i18n';
import { isPending, showPending } from '../../lib/pending';
import Button from '../ui/Button.astro';
import Stamp from '../ui/Stamp.astro';
import Value from '../ui/Value.astro';

const t = useDictionary(Astro.currentLocale);
const copy = t.certification;
---

<section class="certification paper" aria-labelledby="mes-13">
  <div class="container layout">
    <div class="month" data-anim="settle">
      <span class="data-label">{copy.monthLabel}</span>
      <span class="number tabular" aria-hidden="true">{COURSE_MONTHS}</span>
      <span class="level">Cambridge {FINAL_CEFR}</span>
      <Stamp class="month-stamp" {...copy.stamp} ink="flame" rotate={-14} size="clamp(7.5rem, 11vw, 9.5rem)" />
    </div>

    <div class="body">
      <h2 id="mes-13">{copy.title}</h2>
      <p class="lead">{copy.lead}</p>

      <ul class="benefits">
        {
          copy.benefits.map((benefit, index) => (
            <li class:list={['benefit', { featured: index === copy.benefits.length - 1 }]} data-anim="row">
              <span class="data-label">{benefit.tag}</span>
              <h3>{benefit.title}</h3>
              <p>{benefit.body}</p>
            </li>
          ))
        }
      </ul>

      <p class="note">
        {copy.note}
        {(showPending || !isPending(copy.examFee)) && <> <Value value={copy.examFee} /></>}
      </p>
      <div class="actions">
        <Button href="#solicitud">{copy.cta}</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .certification {
    padding-block: var(--space-9);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(16rem, 0.8fr) 1.3fr;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
    align-items: center;
  }

  /* Navy "page 13" of the passport: the giant numeral is the hook. */
  .month {
    position: relative;
    display: grid;
    justify-items: start;
    align-content: center;
    gap: var(--space-2);
    min-height: clamp(18rem, 14rem + 14vw, 26rem);
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    border-radius: var(--radius-page);
    background:
      var(--rosette-cover) right -12rem bottom -12rem / 34rem no-repeat,
      radial-gradient(120% 100% at 20% 0%, var(--navy-800), var(--navy-900) 60%, var(--navy-950));
    color: var(--on-navy);
    box-shadow: var(--shadow-page);
  }
  .month .data-label {
    color: var(--on-navy-soft);
  }
  .number {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 800;
    font-size: clamp(8rem, 5rem + 12vw, 15rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
    color: var(--sun);
  }
  .level {
    font-family: var(--font-display);
    font-stretch: 125%;
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  /* Stamped across the page corner, half on the paper, half on the navy page. */
  .month :global(.month-stamp) {
    position: absolute;
    right: -2rem;
    top: -2.5rem;
    mix-blend-mode: normal;
  }

  .body {
    display: grid;
    gap: var(--space-5);
    justify-items: start;
  }
  h2 {
    font-size: var(--step-3);
    color: var(--navy-900);
  }
  .lead {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 40rem;
  }

  .benefits {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    width: 100%;
  }
  .benefit {
    display: grid;
    align-content: start;
    gap: var(--space-2);
    padding: var(--space-5);
    border-radius: 10px;
    background:
      var(--rosette-paper) 140% 140% / 16rem no-repeat,
      var(--paper);
    box-shadow: var(--shadow-page), inset 0 0 0 1px var(--paper-edge);
  }
  .benefit h3 {
    font-size: var(--step-1);
    line-height: 1.15;
    color: var(--navy-900);
  }
  .benefit p {
    color: var(--ink-soft);
  }
  /* The free Cambridge preparation is the headline benefit: inked in sun. */
  .featured {
    background:
      var(--rosette-paper) 140% 140% / 16rem no-repeat,
      #fbe9a8;
    box-shadow: var(--shadow-page), inset 0 0 0 2px var(--sun-deep);
  }
  .featured .data-label {
    color: var(--navy-900);
    font-weight: 700;
  }

  .note {
    font-size: var(--step--1);
    color: var(--ink-soft);
    max-width: 40rem;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: 1fr;
    }
    .month {
      min-height: 0;
    }
    .month :global(.month-stamp) {
      right: -0.5rem;
      top: -2rem;
      --size: 6.5rem !important;
    }
  }
  @media (max-width: 640px) {
    .benefits {
      grid-template-columns: 1fr;
    }
  }
</style>
